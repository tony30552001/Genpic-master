{
  "rules": [
    {
      "enabled": true,
      "name": "delete-abandoned-user-upload-staging",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 2
            }
          }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["uploads/staging/"]
        }
      }
    }
  ]
}
