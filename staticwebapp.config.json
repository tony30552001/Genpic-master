{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/templates/*", "*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico"]
  },
  "mimeTypes": {
    ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
  }
}
