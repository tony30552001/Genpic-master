# Google OAuth public client (credential is exchanged once with the BFF)
VITE_GOOGLE_CLIENT_ID=

# API Gateway
# App Service adapter 本機: http://localhost:3000/api
# Functions fallback: http://localhost:7071/api
# 生產環境: /api  (SWA 代理到 linked App Service，不需完整 URL)
VITE_API_BASE_URL=http://localhost:3000/api

# Local auth bypass (本地開發才設 true，生產環境必須為 false)
VITE_AUTH_BYPASS=false

# LINE Integration (Track B: LIFF Share)
# Create a LIFF App in LINE Developers Console -> Messaging API -> LIFF -> Add
VITE_LIFF_ID=

# App Service upload staging cleanup
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_MS=3600000
UPLOAD_CLEANUP_BATCH_SIZE=100
